{
    "ai": {
        "analysis_concurrency": 2,
        "api_key_env": "GOOGLE_API_KEY",
        "enrichment_concurrency": 2,
        "languages": [
            "zh",
            "en"
        ],
        "max_tokens": 8192,
        "model": "gemini-3.8-flash",
        "provider": "gemini",
        "temperature": 0.3,
        "throttle_sec": 1
    },
    "collection": {
        "time_window_hours": 24
    },
    "digest": {
        "category_groups": {},
        "default_group": "other",
        "default_group_limit": null,
        "max_items": 20,
        "profile_order": [
            "tech-news",
            "tech-blog",
            "finance-news"
        ]
    },
    "display": {
        "icon_style": "emoji"
    },
    "email": {
        "enabled": false,
        "imap_port": 993,
        "imap_server": "imap.qq.com",
        "email_address": "xxx@qq.com",
        "sender_name": "Horizon Daily",
        "smtp_port": 465,
        "smtp_server": "smtp.qq.com",
        "subscribe_keyword": "SUBSCRIBE",
        "unsubscribe_keyword": "UNSUBSCRIBE"
    },
    "processing": {
        "default_profile": "tech-news",
        "profile_settings": {
            "finance-news": {
                "threshold": 7.0,
                "topic_dedup": true
            },
            "tech-blog": {
                "threshold": 4.0,
                "topic_dedup": false
            },
            "tech-news": {
                "threshold": 7.0,
                "topic_dedup": true
            }
        },
        "profiles_dir": "profiles"
    },
    "sources": {
